{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cat Clock",
  "version": "0.1.1",
  "identifier": "com.catclock.app",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Cat Clock",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required",
        "visibleOnAllWorkspaces": true,
        "width": 800,
        "height": 600
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Two desktop cats that show the time in two cities",
    "copyright": "(c) 2026 skot-chen. Code: PolyForm Noncommercial 1.0.0; cat art all rights reserved",
    "macOS": { "signingIdentity": "-" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
