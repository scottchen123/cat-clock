  "compilerOptions": {
    "allowJs": true, "checkJs": true, "noEmit": true, "strict": true,
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "types": ["node"], "skipLibCheck": true
  },
  "include": ["src/**/*.js", "src/**/*.d.ts", "tests/**/*.js"]
}
